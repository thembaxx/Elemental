    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-gl": "^58.0.3",
    "expo-haptics": "^58.0.7",
    "expo-status-bar": "~58.0.4",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "^0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-web": "^0.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
